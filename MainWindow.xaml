<Window x:Class="FamilyLibraryTools.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FamilyLibraryTools.Views"
        Title="Family Library Tools" Width="1380" Height="920" MinWidth="1000" MinHeight="800"
        WindowStartupLocation="CenterScreen" Background="#F3F6FA" FontFamily="Segoe UI" FontSize="14"
        Closing="OnClosing" PreviewKeyDown="OnReviewKeyDown" PreviewKeyUp="OnReviewKeyUp"
        PreviewMouseDown="OnReviewMouseDown" PreviewMouseUp="OnReviewMouseUp"
        Activated="OnActivated" Deactivated="OnDeactivated">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="18,10" />
        </Style>
    </Window.Resources>
    <Grid Margin="22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="Family Library Tools" FontSize="25" FontWeight="SemiBold" Foreground="#17344F" />
            <TextBlock Text="Organize your library. Keep every decision clear." Foreground="#536273" Margin="0,4,0,0" />
        </StackPanel>
        <TabControl x:Name="Workflows" Grid.Row="1" SelectedIndex="0" Background="#F3F6FA" BorderBrush="#D8E0E8">
            <TabItem x:Name="OrganizeTab" Header="Auto-Organizer">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="FolderInputs">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="112" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                        <TextBlock Text="Input folder" VerticalAlignment="Center" />
                        <TextBox x:Name="InputPath" Grid.Column="1" Margin="0,0,8,8" TextChanged="OnPathsChanged" AutomationProperties.Name="Input folder path" />
                        <Button Grid.Column="2" Content="Browse..." Margin="0,0,0,8" Click="OnBrowseInput" />
                        <TextBlock Grid.Row="1" Text="Output folder" VerticalAlignment="Center" />
                        <TextBox x:Name="OutputPath" Grid.Row="1" Grid.Column="1" Margin="0,0,8,0" TextChanged="OnPathsChanged" AutomationProperties.Name="Output folder path" />
                        <Button Grid.Row="1" Grid.Column="2" Content="Browse..." Click="OnBrowseOutput" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,14,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ScanButton" Content="1. Scan folders" Click="OnScan" />
                            <Button x:Name="MoveButton" Content="2. Start verified moves" IsEnabled="False" Click="OnStart" Margin="8,0" FontWeight="SemiBold" />
                            <Button x:Name="CancelButton" Content="Cancel" IsEnabled="False" Click="OnCancel" />
                            <Button x:Name="SkipReviewButton" Content="Skip all non-automatic" IsEnabled="False" Click="OnSkipAllReviews" Margin="8,0,0,0"
                                    ToolTip="Leave files needing date confirmation in input and finish all automatic moves in this run." />
                        </StackPanel>
                        <CheckBox x:Name="OcrEnabled" Grid.Column="1" Content="Read dates in images (OCR)" IsChecked="True"
                                  IsEnabled="{Binding IsEnabled, ElementName=ScanButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0,0,0"
                                  ToolTip="PP-OCR Small reads review photos and prepares the next image. Disable to use metadata, filenames and manual dates only." />
                    </Grid>
                    <StackPanel Grid.Row="2" Margin="0,0,0,12">
                        <TextBlock x:Name="Summary" Text="Choose two separate folders. Scanning does not move files." FontWeight="SemiBold" TextWrapping="Wrap" />
                        <ProgressBar x:Name="BusyProgress" Height="3" Margin="0,7,0,7" Visibility="Collapsed" IsIndeterminate="True" />
                        <TextBlock x:Name="Status" Text="Ready" Foreground="#536273" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    </StackPanel>
                    <Grid Grid.Row="3">
                        <Border x:Name="WelcomePanel" Background="White" BorderBrush="#D8E0E8" BorderThickness="1" CornerRadius="8" Padding="28">
                            <StackPanel VerticalAlignment="Center" MaxWidth="750" HorizontalAlignment="Left">
                                <TextBlock Text="A careful path to a clean library" FontSize="23" FontWeight="SemiBold" Foreground="#17344F" Margin="0,0,0,18" />
                                <TextBlock Text="Scan every subfolder, compare complete file contents, and organize all supported photos and videos by capture month." TextWrapping="Wrap" Margin="0,0,0,18" />
                                <TextBlock Text="Organize every version. Additional copies and name collisions receive _DUPLICATE-1, _DUPLICATE-2, and so on. Existing output files are preserved." TextWrapping="Wrap" Margin="0,0,0,14" />
                                <TextBlock Text="Then use the Duplicate Removal tab to compare one pair at a time. Only an explicit choice starts a cancellable 60-second countdown to recoverable quarantine. Quarantined files are retained, with their recovery location shown in the queue." TextWrapping="Wrap" Margin="0,0,0,14" />
                                <TextBlock Text="Dates: use capture metadata, then recognized filename timestamps. If a date needs review, confirm the best available suggestion with Space, choose another source, or enter a date." TextWrapping="Wrap" Margin="0,0,0,14" />
                                <TextBlock Text="On the same volume, the verified original moves intact. Between volumes, a verified copy goes to output and the whole original stays in a recovery folder on the source volume, using additional space. Recovery paths appear in Activity and the journal. Nothing is automatically deleted." TextWrapping="Wrap" Foreground="#536273" />
                            </StackPanel>
                        </Border>
                        <Grid x:Name="DatePanel" Visibility="Collapsed">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <views:MediaPreview x:Name="DatePreview" Margin="0,0,18,0" />
                            <views:DateRegionPicker x:Name="DateRegion" Margin="0,0,18,0" />
                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Confirm the capture month" FontSize="23" FontWeight="SemiBold" Foreground="#17344F" Margin="0,0,0,10" />
                                    <TextBlock x:Name="DateInformation" TextWrapping="Wrap" Margin="0,0,0,12" />
                                    <StackPanel x:Name="DateActions" IsEnabled="False">
                                        <StackPanel x:Name="ImageDatesPanel" Visibility="Collapsed" Margin="0,0,0,10" Focusable="True" KeyboardNavigation.IsTabStop="False">
                                            <TextBlock Text="Dates read from the image" FontWeight="SemiBold" />
                                            <TextBlock x:Name="ImageDateStatus" TextWrapping="Wrap" Margin="0,6" />
                                            <ProgressBar x:Name="ImageDateProgress" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,8"
                                                         Foreground="#397BAE" Background="#E3EDF5" BorderThickness="0" />
                                            <WrapPanel Margin="0,0,0,6">
                                                <Button x:Name="RetryOcr" Content="Try PP-OCR Medium" Click="OnRetryOcr" Padding="10,5" Margin="0,0,6,4"
                                                        ToolTip="Manually read the current image or selected region with the larger model." />
                                                <Button x:Name="SelectDateRegion" Content="Select date region" Click="OnSelectDateRegion" Padding="10,5" Margin="0,0,6,4" />
                                                <Button x:Name="ShowRecognizedText" Content="Show text" Click="OnShowRecognizedText" FontSize="12" Padding="8,3" MinHeight="28" Margin="0,0,0,4"
                                                        ToolTip="Show the recognized text, including text that could not be parsed as a date." />
                                            </WrapPanel>
                                            <TextBox x:Name="RecognizedText" Visibility="Collapsed" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="150"
                                                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Margin="0,0,0,8"
                                                     AutomationProperties.Name="Recognized image text" />
                                            <ItemsControl x:Name="ImageDateChoices">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="#C28B21" BorderThickness="2" CornerRadius="4" Padding="8" Margin="0,4">
                                                            <StackPanel>
                                                                <Image Source="{Binding Evidence}" Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="64" HorizontalAlignment="Left" />
                                                                <TextBlock Text="{Binding Date.DisplayValue}" FontWeight="SemiBold" Margin="0,6,0,0" />
                                                                <TextBlock Text="{Binding Date.Note}" TextWrapping="Wrap" FontSize="12" Margin="0,4" />
                                                                <Button Content="Use this image date and move" Click="OnAcceptImageDate" HorizontalAlignment="Left" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <Border Background="#E6EFF8" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="Best available suggestion: confirm before moving" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock x:Name="SuggestedDateText" TextWrapping="Wrap" Margin="0,6" />
                                                <Button x:Name="AcceptSuggestedDate" Content="Accept suggested date (Space)" Click="OnAcceptSuggestedDate" HorizontalAlignment="Left" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Border>
                                        <Expander x:Name="OtherDates" Header="Other available dates" Margin="0,0,0,10">
                                            <ItemsControl x:Name="DateAlternatives">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Click="OnAcceptAlternativeDate" HorizontalContentAlignment="Left" Margin="0,6,0,0">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Source}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                <TextBlock Text="{Binding DisplayValue}" />
                                                                <TextBlock Text="{Binding Note}" TextWrapping="Wrap" FontSize="12" />
                                                                <TextBlock Text="Use this date and move" Margin="0,4,0,0" />
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                        <TextBlock Text="Or enter a date. Only its year and month determine the folder." TextWrapping="Wrap" Margin="0,0,0,6" />
                                        <DatePicker x:Name="CaptureDatePicker" SelectedDateChanged="OnDateChanged" DateValidationError="OnDateValidationError"
                                                    TextBoxBase.TextChanged="OnDateTextChanged" PreviewGotKeyboardFocus="OnManualDateFocus" SelectedDateFormat="Long" Margin="0,0,0,6" />
                                        <TextBlock x:Name="DateDestination" TextWrapping="Wrap" Margin="0,0,0,8" />
                                        <WrapPanel>
                                            <Button x:Name="ConfirmDate" Content="Use entered date and move" Click="OnConfirmDate" IsEnabled="False" Margin="0,0,8,8" />
                                            <Button Content="Leave this file in input" Click="OnSkipDate" Margin="0,0,0,8" />
                                        </WrapPanel>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                    <Expander Grid.Row="4" Header="Activity and scan issues" Margin="0,12,0,0" IsExpanded="False">
                        <ListBox x:Name="Activity" Height="86" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                    </Expander>
                </Grid>
            </TabItem>
        <TabItem x:Name="RemovalTab" Header="Duplicate Removal"><views:DuplicateReview x:Name="RemovalReview" SessionChanged="OnRemovalSessionChanged" /></TabItem>
        <TabItem x:Name="DeveloperTab" Header="Developer Tools" Visibility="Collapsed"><views:OcrBenchmarkView x:Name="BenchmarkView" SessionChanged="OnBenchmarkSessionChanged" /></TabItem>
        </TabControl>
    </Grid>
</Window>

