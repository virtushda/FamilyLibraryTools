<UserControl x:Class="FamilyLibraryTools.Views.DuplicateReview"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FamilyLibraryTools.Views">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="FolderInputs">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="Organized library" VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBox x:Name="LibraryPath" Grid.Column="1" AutomationProperties.Name="Library for duplicate review" />
            <Button Grid.Column="2" Content="Browse..." Click="OnBrowse" Margin="8,0" />
            <Button x:Name="ScanButton" Grid.Column="3" Content="Scan duplicates" Click="OnScan" />
        </Grid>
        <StackPanel Grid.Row="1" Margin="0,12">
            <DockPanel>
                <Button x:Name="StopButton" DockPanel.Dock="Right" Content="STOP ALL" Click="OnStopAll" IsEnabled="False"
                        Background="#A51D27" Foreground="White" FontWeight="Bold" Margin="16,0,0,0" />
                <TextBlock x:Name="ReviewStatus" Text="Scan the organized library, then choose what to keep. Nothing is selected automatically."
                           TextWrapping="Wrap" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Text="Rejected files move to recoverable quarantine, not the Recycle Bin. Each choice waits 60 seconds. CANCEL DELETION removes that choice; choosing again starts a fresh 60 seconds. STOP ALL cancels pending choices. A move already started may finish."
                       TextWrapping="Wrap" Foreground="#536273" Margin="0,8,0,0" />
            <Expander Header="Recovery information" Margin="0,5,0,0" FontSize="12">
                <StackPanel>
                    <TextBlock Text="Quarantine keeps the complete original file. To recover one, copy or move it from the location shown below back to your library. The journal records its original location. Quarantine files are never automatically deleted or reviewed again." TextWrapping="Wrap" />
                    <TextBox x:Name="RecoveryPath" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0,4" TextWrapping="Wrap" />
                    <TextBox x:Name="JournalPath" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0,4" TextWrapping="Wrap" />
                </StackPanel>
            </Expander>
        </StackPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="440" /><ColumnDefinition Width="10" /><ColumnDefinition Width="300" MinWidth="240" />
            </Grid.ColumnDefinitions>
        <Grid x:Name="PairPanel">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel>
                <TextBlock x:Name="ComparisonHint" TextWrapping="Wrap" Foreground="#68521E" Margin="0,0,0,8" />
                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="Shared zoom" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button DockPanel.Dock="Right" Content="Fit / reset" Click="OnResetView" Padding="10,3" MinHeight="28" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=Zoom, StringFormat={}{0:0.0}x}" Width="48" VerticalAlignment="Center" TextAlignment="Center" />
                    <Slider x:Name="Zoom" Minimum="1" Maximum="8" Value="1" SmallChange="0.25" LargeChange="1"
                            IsEnabled="False" ValueChanged="OnZoom" VerticalAlignment="Center" AutomationProperties.Name="Zoom both previews"
                            ToolTip="1x fits each preview. Drag either photo when zoomed to pan both." />
                </DockPanel>
            </StackPanel>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                <views:MediaPreview x:Name="OriginalPreview" Margin="0,0,6,0" />
                <views:MediaPreview x:Name="DuplicatePreview" Grid.Column="1" Margin="6,0,0,0" />
            </Grid>
            <WrapPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,8,0,0">
                <Button x:Name="KeepOriginal" Content="Keep LEFT&#x0a;Quarantine RIGHT after 60s" Click="OnKeepOriginal" IsEnabled="False" Margin="3" />
                <Button x:Name="KeepBoth" Content="Keep both; rename RIGHT" ToolTip="Keep both files. Rename RIGHT with -1, -2, etc. Exact copies will still be detected on future scans." Click="OnKeepBoth" IsEnabled="False" Margin="3" />
                <Button x:Name="KeepDuplicate" Content="Keep RIGHT&#x0a;Quarantine LEFT after 60s" Click="OnKeepDuplicate" IsEnabled="False" Margin="3" />
                <Button x:Name="SkipPair" Content="Skip for now" Click="OnSkipPair" IsEnabled="False" Margin="3" />
            </WrapPanel>
        </Grid>
        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" Background="#D8E0E8" ResizeBehavior="PreviousAndNext" />
        <GroupBox Grid.Column="2" Header="Quarantine queue">
            <ListBox x:Name="QueueList" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                            <StackPanel Margin="4,7">
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" ToolTip="{Binding Paths}" />
                                <TextBox Text="{Binding Status, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" />
                                <Button Content="CANCEL DELETION" Click="OnCancelDeletion" Tag="{Binding}"
                                        IsEnabled="{Binding CanCancel}" Margin="0,8,0,0" HorizontalAlignment="Left" />
                            </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>
        </Grid>
    </Grid>
</UserControl>
