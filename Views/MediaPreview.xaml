<UserControl x:Class="FamilyLibraryTools.Views.MediaPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="White" BorderBrush="#D8E0E8" BorderThickness="1" CornerRadius="8" Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="100" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,8">
                <TextBlock x:Name="FileTitle" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="ResolutionText" Foreground="#536273" FontSize="12" Margin="0,3,0,0" />
            </StackPanel>
            <Grid x:Name="Viewport" Grid.Row="1" Background="#EEF2F6" ClipToBounds="True" SizeChanged="OnViewportSizeChanged"
                  MouseLeftButtonDown="OnPanStart" MouseMove="OnPanMove" MouseLeftButtonUp="OnPanEnd" LostMouseCapture="OnPanLost">
                <Grid RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ViewScale" />
                            <TranslateTransform x:Name="ViewOffset" />
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Image x:Name="Photo" Stretch="Uniform" />
                    <MediaElement x:Name="Video" Visibility="Collapsed" LoadedBehavior="Manual" UnloadedBehavior="Close"
                                  ScrubbingEnabled="True" Stretch="Uniform" MediaOpened="OnMediaOpened" MediaFailed="OnMediaFailed" />
                </Grid>
                <TextBlock x:Name="PreviewMessage" Text="Select a file to preview" TextWrapping="Wrap" Margin="16"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#536273" />
            </Grid>
            <StackPanel x:Name="VideoControls" Grid.Row="2" Visibility="Collapsed" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Play" Click="OnPlay" Padding="12,4" />
                    <Button Content="Pause" Click="OnPause" Padding="12,4" Margin="6,0" />
                    <TextBlock x:Name="DurationText" VerticalAlignment="Center" />
                </StackPanel>
                <Slider x:Name="Seek" Minimum="0" Maximum="1" ValueChanged="OnSeek" ToolTip="Seek through the video" />
            </StackPanel>
            <ScrollViewer Grid.Row="3" MaxHeight="100" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                <TextBlock x:Name="FileDetails" TextWrapping="Wrap" FontSize="12" Foreground="#536273" />
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
