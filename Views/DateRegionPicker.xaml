<UserControl x:Class="FamilyLibraryTools.Views.DateRegionPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <Border Background="White" BorderBrush="#D8E0E8" BorderThickness="1" CornerRadius="8" Padding="12">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Text="Drag around the date, leaving a little space around the text." TextWrapping="Wrap" Margin="0,0,0,8" />
            <Canvas x:Name="Surface" Grid.Row="1" Background="#EEF2F6" ClipToBounds="True" Cursor="Cross"
                    SizeChanged="OnSizeChanged" MouseLeftButtonDown="OnStart" MouseMove="OnMove"
                    MouseLeftButtonUp="OnEnd" LostMouseCapture="OnCaptureLost">
                <Image x:Name="Photo" Stretch="Fill" IsHitTestVisible="False" />
                <Rectangle x:Name="Outline" Stroke="#B87500" StrokeThickness="2" Fill="#25FFCC44" IsHitTestVisible="False" Visibility="Collapsed" />
            </Canvas>
            <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                <Button x:Name="ReadRegion" Content="Read selected region" IsEnabled="False" Click="OnRead" Margin="0,0,8,0" />
                <Button x:Name="CancelRegion" Content="Cancel selection" Click="OnCancel" />
            </WrapPanel>
        </Grid>
    </Border>
</UserControl>
