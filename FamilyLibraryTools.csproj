<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Core\**;Tests\**;.codexTemp\**" />
    <Page Remove="Tests\**" />
    <ProjectReference Include="Core\FamilyLibraryTools.Core.csproj" />
    <PackageReference Include="RapidOcrNet" Version="4.2.0" ExcludeAssets="build" />
    <Content Include="models\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
